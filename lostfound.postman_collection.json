            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"LOST\",\n  \"title\": \"Casio Scientific Calculator FX-991EX\",\n  \"category\": \"Electronics\",\n  \"description\": \"Black color Casio scientific calculator with white slider cover and my name sticker Rahul on the back\",\n  \"location\": \"Library 2nd Floor Reading Room\",\n  \"incidentDate\": \"2026-10-10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items"]
            }
          }
        },
