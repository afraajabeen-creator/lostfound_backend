        {
          "name": "Admin Approve Claim (Generates OTP)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"VERIFIED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "1", "status"]
            }
          }
        },
        {
          "name": "Admin Reject Claim with Reason",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"rejectionReason\": \"Provided proof does not match the actual item serial number.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "1", "status"]
            }
          }
        },
        {
          "name": "Admin Verify Pickup OTP at Desk",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims/1/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "1", "verify-otp"]
            }
          }
        }
