          "name": "Report Found Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"FOUND\",\n  \"title\": \"Casio Scientific Calculator FX-991EX\",\n  \"category\": \"Electronics\",\n  \"description\": \"Found a black Casio calculator left on table 4 with white cover\",\n  \"location\": \"Library 2nd Floor\",\n  \"incidentDate\": \"2026-10-10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items"]
